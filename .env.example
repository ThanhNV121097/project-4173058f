# Local PostgreSQL user for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose. Replace in local .env; never commit secrets.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# Optional host port for backend.
BACKEND_PORT=8080

# Optional host port for frontend.
FRONTEND_PORT=3000

# Browser-visible backend origin for frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side backend origin for frontend container.
API_ORIGIN=http://backend:8080
